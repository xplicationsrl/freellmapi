# Runtime image the sandbox worker runs user code in.
# Build:  docker build -f sandbox-worker/Dockerfile.runtime -t freellmapi-sandbox:1 sandbox-worker
# Bump the tag when the package set changes; the worker records the image per job.
FROM python:3.12-slim-bookworm

# Pinned, prebuilt wheels only. No package installation happens at run time.
RUN pip install --no-cache-dir \
      numpy==2.1.3 \
      pandas==2.2.3 \
      matplotlib==3.9.2 \
    && rm -rf /root/.cache

RUN useradd --no-create-home --uid 65534 --shell /usr/sbin/nologin sandbox 2>/dev/null || true
WORKDIR /work
