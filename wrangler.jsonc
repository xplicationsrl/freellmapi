{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freellmapi",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  // Dashboard is static; API paths run the Worker, which proxies to the backend.
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/v1beta/*", "/mcp", "/mcp/*", "/u/*"]
  },
  "vars": {
    "BACKEND_URL": "https://instantly-suggest-abs-graphs.trycloudflare.com"
  }
}
